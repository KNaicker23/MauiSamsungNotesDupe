<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSamsungNotesDupe.RecycleBinPage"
             Title="RecycleBinPage">
    <VerticalStackLayout>
        <Label 
            Text="Recycle bin" FontSize="50" FontAttributes="Bold"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <ContentView BackgroundColor="White" Margin="20" HorizontalOptions="Fill" >
            <Label Text="This Recycle bin shows items deleted from Samsung Notes on all of your synced devices. These items will be permanently deleted after 30 days." TextColor="Black" />
        </ContentView>
    </VerticalStackLayout>
</ContentPage> 