<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSamsungNotesDupe.RecycleBinPage"
             Title="Recycle bin"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,Auto,*" Padding="10">
        <StackLayout Grid.Row="0" Padding="10">
            <Label Text="Recycle bin" FontSize="32" FontAttributes="Bold" TextColor="Black" />
            <Label Text="1 note" FontSize="14" TextColor="Grey" />
        </StackLayout>

        <ContentView Grid.Row="1" BackgroundColor="WhiteSmoke" Margin="10,0,10,10" Padding="10">
            <Label Text="This Recycle bin shows items deleted from Samsung Notes on all of your synced devices. These items will be permanently deleted after 30 days." TextColor="Black" />
        </ContentView>

        <CollectionView Grid.Row="2" SelectionMode="None" ItemsSource="{Binding}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="15" BackgroundColor="WhiteSmoke" Margin="5">
                        <StackLayout Spacing="8">
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                            <Label Text="{Binding Content}" FontSize="14" TextColor="IndianRed" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label Text="{Binding Date, StringFormat='Deleted {0}'}" FontSize="12" TextColor="DimGrey" />
                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage> 