<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSamsungNotesDupe.SharedNotePage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*" Padding="10">
        <StackLayout Grid.Row="0" Padding="10">
            <Label Text="Shared notes" HorizontalOptions="Center" FontSize="32" FontAttributes="Bold" TextColor="Black" />
            <Label Grid.Row="0" Text="No shared items" TextColor="Black" FontSize="Medium" HorizontalOptions="Center"/>
        </StackLayout>

        
        <ContentView Grid.Row="1" BackgroundColor="WhiteSmoke" Margin="10,0,10,10" Padding="10" VerticalOptions="Center">
            
            <Label Text="Share a note or entire notebook that everyone can edit at the same time." TextColor="Black" />
            
        </ContentView>
        </Grid>
</ContentPage>