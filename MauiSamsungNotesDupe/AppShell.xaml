<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiSamsungNotesDupe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiSamsungNotesDupe"
    FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <Grid ColumnDefinitions="*,Auto" Padding="20,40,20,20" BackgroundColor="White">
            <Label Grid.Column="0" Text="Samsung Notes" FontSize="24" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center"/>
            <Button Grid.Column="1" ImageSource="settings.png" Clicked="SettingsButton_Clicked" BackgroundColor="White"/>
        </Grid>
    </Shell.FlyoutHeader>
    
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="All notes" Icon="book.png" 
        ContentTemplate="{DataTemplate local:NotesPage}" />
    </FlyoutItem>

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="Locked notes" Icon="lock.png" ContentTemplate="{DataTemplate local:LockedNotePage}" />
    </FlyoutItem>

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="Shared notes" Icon="shared_folder.png" ContentTemplate="{DataTemplate local:SharedNotePage}" />
    </FlyoutItem>

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="Recycle bin" Icon="delete.png" ContentTemplate="{DataTemplate local:RecycleBinPage}" />
    </FlyoutItem>

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="Folders" Icon="folders.png" ContentTemplate="{DataTemplate local:NotesPage}" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <Button Text="Manage folders" BackgroundColor="DimGrey" TextColor="Black" Margin="20,10" CornerRadius="10" Clicked="ManageFoldersButton_Clicked" />
    </Shell.FlyoutFooter>

</Shell>